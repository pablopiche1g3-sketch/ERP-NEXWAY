
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Store extra user details.",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "manager", "employee"] },
        "lastLogin": { "type": "string", "format": "date-time" }
      },
      "required": ["fullName", "role"]
    },
    "InventoryItem": {
      "title": "Inventory Item",
      "description": "Products or materials in stock.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "quantity": { "type": "number" },
        "price": { "type": "number" },
        "category": { "type": "string" }
      },
      "required": ["name", "sku", "quantity"]
    },
    "Warehouse": {
      "title": "Warehouse",
      "description": "Physical storage locations.",
      "type": "object",
      "properties": {
        "name": { "type": "string" }
      },
      "required": ["name"]
    },
    "Expense": {
      "title": "Internal Expense",
      "description": "Daily expenses or reimbursements from cash drawer.",
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string", "enum": ["Gasolina", "Anticipo", "Reintegro", "Alimentación", "Otros"] },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["description", "amount", "category", "timestamp"]
    },
    "JournalEntry": {
      "title": "Journal Entry",
      "description": "Manual accounting records for adjustments.",
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["Ingreso", "Egreso"] },
        "account": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["description", "amount", "type", "account", "timestamp"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Tax and contact details for business or individual clients.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["Individual", "Empresa"] },
        "nit": { "type": "string" },
        "nrc": { "type": "string" },
        "giro": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "address": { "type": "string" }
      },
      "required": ["name", "type", "nit", "email"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Information about business suppliers.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "nit": { "type": "string" },
        "nrc": { "type": "string" },
        "giro": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "applyRetention": { "type": "boolean", "description": "Si aplica retención del 1%" },
        "applyPerception": { "type": "boolean", "description": "Si aplica percepción del 1%" }
      },
      "required": ["name", "nit", "nrc"]
    },
    "CompanyProfile": {
      "title": "Company Profile",
      "description": "Legal and institutional information of the business.",
      "type": "object",
      "properties": {
        "legalName": { "type": "string" },
        "brandName": { "type": "string" },
        "nit": { "type": "string" },
        "nrc": { "type": "string" },
        "giro": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "vision": { "type": "string" },
        "mission": { "type": "string" }
      },
      "required": ["legalName", "nit", "nrc"]
    },
    "SystemConfig": {
      "title": "System Configuration",
      "description": "Global settings for modules and cash management.",
      "type": "object",
      "properties": {
        "cashFloat": { "type": "number" },
        "modules": { "type": "object" }
      }
    },
    "DailyClosing": {
      "title": "Daily Closing",
      "description": "Snapshots of daily cash reconciliation.",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "cashFloat": { "type": "number" },
        "systemCashSales": { "type": "number" },
        "physicalCashFound": { "type": "number" },
        "expenses": { "type": "number" },
        "difference": { "type": "number" },
        "totalFacturado": { "type": "number" },
        "denominations": { "type": "object" },
        "closedBy": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "InstitutionalProject": {
      "title": "Institutional Project",
      "description": "Licitaciones y proyectos institucionales.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "purchaseOrder": { "type": "string" },
        "totalBudget": { "type": "number" },
        "status": { "type": "string" },
        "customerName": { "type": "string" },
        "items": { "type": "array", "description": "Productos comprometidos en la oferta." }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/backend/entities/UserProfile",
      "description": "User profile data."
    },
    "/inventory": {
      "schema": "#/backend/entities/InventoryItem",
      "description": "Global inventory list."
    },
    "/warehouses": {
      "schema": "#/backend/entities/Warehouse",
      "description": "Physical storage points."
    },
    "/expenses": {
      "schema": "#/backend/entities/Expense",
      "description": "Internal business expenses."
    },
    "/journal": {
      "schema": "#/backend/entities/JournalEntry",
      "description": "General accounting ledger."
    },
    "/sales": {
      "schema": "object",
      "description": "Sales transactions."
    },
    "/customers": {
      "schema": "#/backend/entities/Customer",
      "description": "Customer database."
    },
    "/suppliers": {
      "schema": "#/backend/entities/Supplier",
      "description": "Supplier database."
    },
    "/system/company_profile": {
      "schema": "#/backend/entities/CompanyProfile",
      "description": "The institution's corporate data."
    },
    "/system/cash_config": {
      "schema": "#/backend/entities/SystemConfig",
      "description": "Global cash management settings."
    },
    "/system/module_config": {
      "schema": "object",
      "description": "Status of operational modules."
    },
    "/daily_closings": {
      "schema": "#/backend/entities/DailyClosing",
      "description": "Records of daily register closures."
    },
    "/institutional_projects": {
      "schema": "#/backend/entities/InstitutionalProject",
      "description": "Expedientes de licitaciones."
    },
    "/institutional_sales": {
      "schema": "object",
      "description": "Ingresos por proyectos."
    },
    "/institutional_purchases": {
      "schema": "object",
      "description": "Egresos por costos de proyectos."
    }
  }
}
