
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Store extra user details.",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "manager", "employee"] },
        "lastLogin": { "type": "string", "format": "date-time" }
      },
      "required": ["fullName", "role"]
    },
    "InventoryItem": {
      "title": "Inventory Item",
      "description": "Products or materials in stock.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "quantity": { "type": "number" },
        "price": { "type": "number" },
        "category": { "type": "string" }
      },
      "required": ["name", "sku", "quantity"]
    },
    "Expense": {
      "title": "Internal Expense",
      "description": "Daily expenses or reimbursements from cash drawer.",
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string", "enum": ["Gasolina", "Anticipo", "Reintegro", "Alimentación", "Otros"] },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["description", "amount", "category", "timestamp"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Tax and contact details for business or individual clients.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["Individual", "Empresa"] },
        "nit": { "type": "string" },
        "nrc": { "type": "string" },
        "giro": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "address": { "type": "string" }
      },
      "required": ["name", "type", "nit", "email"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/backend/entities/UserProfile",
      "description": "User profile data."
    },
    "/inventory": {
      "schema": "#/backend/entities/InventoryItem",
      "description": "Global inventory list."
    },
    "/expenses": {
      "schema": "#/backend/entities/Expense",
      "description": "Internal business expenses."
    },
    "/sales": {
      "schema": "object",
      "description": "Sales transactions."
    },
    "/customers": {
      "schema": "#/backend/entities/Customer",
      "description": "Customer database."
    }
  }
}
